{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:ecl-pl:schema:patent-grant:0.1-draft:root:v2","title":"ECL-PL PatentGrantManifest","description":"Architecture-stage schema for an ECL Patent License grant manifest. Validation does not establish patent ownership, authority, infringement, enforceability, legal review, or operative status. This root is part of the closed ECL-PL schema resource set v2; conforming validation pre-registers the exact content-addressed resources and performs no network schema retrieval.","type":"object","additionalProperties":false,"required":["schema_version","grant_id","status","patent_license","patent_licensor","covered_implementation","claim_scope","effective_date","downstream_policy","provenance"],"properties":{"schema_version":{"const":"0.1-draft"},"grant_id":{"type":"string","pattern":"^ECL-PG-[a-z0-9][a-z0-9-]*-[0-9]{8}-[1-9][0-9]*(?![\\s\\S])"},"status":{"type":"string","enum":["draft","candidate","superseded","withdrawn"]},"patent_license":{"$ref":"urn:ecl-pl:schema:patent-grant:0.1-draft:core:v2#/$defs/patent_license"},"patent_licensor":{"$ref":"urn:ecl-pl:schema:patent-grant:0.1-draft:core:v2#/$defs/patent_licensor"},"covered_implementation":{"$ref":"urn:ecl-pl:schema:patent-grant:0.1-draft:core:v2#/$defs/covered_implementation"},"claim_scope":{"$ref":"urn:ecl-pl:schema:patent-grant:0.1-draft:core:v2#/$defs/claim_scope"},"effective_date":{"type":"string","format":"date","pattern":"^(?:(?:[0-9]{4})-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)(?![\\s\\S])"},"expiration_policy":{"type":"string"},"downstream_policy":{"$ref":"urn:ecl-pl:schema:patent-grant:0.1-draft:core:v2#/$defs/downstream_policy"},"defensive_termination":{"$ref":"urn:ecl-pl:schema:patent-grant:0.1-draft:core:v2#/$defs/defensive_termination"},"ecl_bundle_reference":{"$ref":"urn:ecl-pl:schema:patent-grant:0.1-draft:policy:v2#/$defs/ecl_bundle_reference"},"known_patents":{"$ref":"urn:ecl-pl:schema:patent-grant:0.1-draft:policy:v2#/$defs/known_patents"},"known_encumbrances":{"$ref":"urn:ecl-pl:schema:patent-grant:0.1-draft:policy:v2#/$defs/known_encumbrances"},"provenance":{"$ref":"urn:ecl-pl:schema:patent-grant:0.1-draft:policy:v2#/$defs/provenance"},"legal_review":{"$ref":"urn:ecl-pl:schema:patent-grant:0.1-draft:policy:v2#/$defs/legal_review"}},"allOf":[{"if":{"properties":{"claim_scope":{"properties":{"combination_expansion":{"const":"defined-combinations-only"}},"required":["combination_expansion"]}},"required":["claim_scope"]},"then":{"properties":{"covered_implementation":{"required":["combination_boundary"]}}}},{"if":{"properties":{"claim_scope":{"required":["enumerated_claims"]}},"required":["claim_scope"]},"then":{"not":{"required":["known_patents"]}}},{"if":{"properties":{"patent_licensor":{"properties":{"identity_reference":{"properties":{"subject_type":{"const":"individual"}},"required":["subject_type"]}},"required":["identity_reference"]}},"required":["patent_licensor"]},"then":{"properties":{"patent_licensor":{"properties":{"name":{"type":"string","minLength":2,"maxLength":160,"pattern":"^(?![\\s\\S]*[0-9])(?!(?:[\\s\\S]*)(?:[Ss][Ss][Nn]|[Dd][Nn][Ii]|[Pp][Aa][Ss][Ss][Pp][Oo][Rr][Tt]|[Gg][Oo][Vv][Ee][Rr][Nn][Mm][Ee][Nn][Tt][ -]?[Ii][Dd]|[Nn][Aa][Tt][Ii][Oo][Nn][Aa][Ll][ -]?[Ii][Dd]|[Tt][Aa][Xx][ -]?[Ii][Dd]))(?![\\s\\S]*[\\r\\n\\t/:;=@#%<>\\\\])[\\s\\S]{2,160}(?![\\s\\S])","description":"Public individual display name only. Digits, identifier labels, control characters, and identifier-like delimiters are structurally rejected; release privacy validation remains mandatory."},"identity_reference":{"properties":{"jurisdiction":{"type":"string","pattern":"^(?:ISO3166-1:[A-Z]{2}|ISO3166-2:[A-Z]{2}-[A-Z0-9]{1,3})(?![\\s\\S])","description":"Canonical ISO 3166 country or subdivision code spelling. Release validation must verify existence against the authoritative ISO 3166 registry."}}}}}}}}]}
