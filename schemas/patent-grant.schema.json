{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Exergism-Commons/ecl-patent-license/blob/main/schemas/patent-grant.schema.json","title":"ECL-PL PatentGrantManifest","description":"Architecture-stage schema for an ECL Patent License grant manifest. Validation does not establish patent ownership, authority, infringement, enforceability, legal review, or operative status.","type":"object","additionalProperties":false,"required":["schema_version","grant_id","status","patent_license","patent_licensor","covered_implementation","claim_scope","effective_date","downstream_policy","provenance"],"properties":{"schema_version":{"const":"0.1-draft"},"grant_id":{"type":"string","pattern":"^ECL-PG-[a-z0-9][a-z0-9-]*-[0-9]{8}-[1-9][0-9]*(?![\\s\\S])"},"status":{"type":"string","enum":["draft","candidate","superseded","withdrawn"]},"patent_license":{"$ref":"patent-grant-core.schema.json#/$defs/patent_license"},"patent_licensor":{"$ref":"patent-grant-core.schema.json#/$defs/patent_licensor"},"covered_implementation":{"$ref":"patent-grant-core.schema.json#/$defs/covered_implementation"},"claim_scope":{"$ref":"patent-grant-core.schema.json#/$defs/claim_scope"},"effective_date":{"type":"string","format":"date","pattern":"^(?:(?:[0-9]{4})-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)(?![\\s\\S])"},"expiration_policy":{"type":"string"},"downstream_policy":{"$ref":"patent-grant-core.schema.json#/$defs/downstream_policy"},"defensive_termination":{"$ref":"patent-grant-core.schema.json#/$defs/defensive_termination"},"ecl_bundle_reference":{"$ref":"patent-grant-policy.schema.json#/$defs/ecl_bundle_reference"},"known_patents":{"$ref":"patent-grant-policy.schema.json#/$defs/known_patents"},"known_encumbrances":{"$ref":"patent-grant-policy.schema.json#/$defs/known_encumbrances"},"provenance":{"$ref":"patent-grant-policy.schema.json#/$defs/provenance"},"legal_review":{"$ref":"patent-grant-policy.schema.json#/$defs/legal_review"}},"allOf":[{"if":{"properties":{"claim_scope":{"properties":{"combination_expansion":{"const":"defined-combinations-only"}},"required":["combination_expansion"]}},"required":["claim_scope"]},"then":{"properties":{"covered_implementation":{"required":["combination_boundary"]}}}},{"if":{"properties":{"claim_scope":{"required":["enumerated_claims"]}},"required":["claim_scope"]},"then":{"not":{"required":["known_patents"]}}}]}
